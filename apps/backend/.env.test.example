# Copy to apps/backend/.env.test (gitignored) before running
# `npm run -w apps/backend test:integration`. Integration tests delete rows
# from real tables, so DATABASE_URL must point at the separate ctcj_test
# database -- test/integration/setupEnv.js refuses to run otherwise.
NODE_ENV=test
PORT=3001

DATABASE_URL="postgresql://ctcj:ctcj_dev_password@localhost:5432/ctcj_test?schema=public"

JWT_ACCESS_SECRET="test-only-secret-not-for-production-use"
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=ctcj_refresh

# Mailhog from docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CTCJ <no-reply@ctcj.local>"

APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
