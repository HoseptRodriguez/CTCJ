# --- Backend (apps/backend/.env) ---
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://ctcj:ctcj_dev_password@localhost:5432/ctcj_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-in-dev"
JWT_ACCESS_TTL_SECONDS=900

# Refresh token cookie
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=ctcj_refresh

# Email (dev: point at Mailhog/Ethereal test SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CTCJ <no-reply@ctcj.local>"

# App URL (used to build email verification/reset links)
APP_PUBLIC_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# --- Frontend (apps/frontend/.env) ---
VITE_API_BASE_URL=http://localhost:3000
